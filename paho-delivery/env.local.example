# Mercado Pago (Fase 1 — Checkout Pro simple)
# Access Token de PRODUCCIÓN de tu cuenta de MP (Developers > Tus integraciones)
MP_ACCESS_TOKEN=

# URL pública del sitio (usada para las back_urls de MP)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase (proyecto de PAHO en Firebase Console) — cliente, público
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (solo servidor — usado en /api para crear órdenes con
# el Admin SDK). Sacar estos tres valores del mismo JSON de cuenta de
# servicio que se usa en scripts/seed.mjs. PRIVATE_KEY va con los \n
# literales (no saltos de línea reales) al pegarlo en el .env.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Anthropic (solo servidor — usado en /api/productos/generar-desde-foto
# para sugerir título/categoría/condición a partir de una foto)
ANTHROPIC_API_KEY=
